generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Auth ----------

model Admin {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ---------- Catalog ----------

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  order     Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  description String
  price       Decimal      @db.Decimal(10, 2)
  images      String[]     @default([])
  variants    Json?
  available   Boolean      @default(true)
  featured    Boolean      @default(false)
  categoryId  String
  category    Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  orderItems  OrderItem[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([categoryId])
}

// ---------- Customers & Orders ----------

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  email     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
}

enum DeliveryType {
  PICKUP
  DELIVERY
}

enum PaymentMethod {
  CASH
  CARD_ON_DELIVERY
  ONLINE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED
}

model Order {
  id             String        @id @default(cuid())
  orderNumber    String        @unique
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerName   String
  customerPhone  String
  customerEmail  String?
  deliveryType   DeliveryType
  address        String?
  city           String?
  scheduledDate  DateTime
  scheduledTime  String
  paymentMethod  PaymentMethod
  status         OrderStatus   @default(PENDING)
  notes          String?
  subtotal       Decimal       @db.Decimal(10, 2)
  deliveryFee    Decimal       @db.Decimal(10, 2) @default(0)
  total          Decimal       @db.Decimal(10, 2)
  items          OrderItem[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status])
  @@index([customerId])
}

model OrderItem {
  id                  String  @id @default(cuid())
  orderId             String
  order               Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId           String?
  product             Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName         String
  variant             String?
  quantity            Int
  unitPrice           Decimal @db.Decimal(10, 2)
  totalPrice          Decimal @db.Decimal(10, 2)
  specialInstructions String?

  @@index([orderId])
}

model CustomCakeRequest {
  id          String   @id @default(cuid())
  name        String
  phone       String
  email       String?
  occasion    String
  servings    String?
  budget      String?
  dateNeeded  DateTime
  details     String
  status      OrderStatus @default(PENDING)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------- Content ----------

model Review {
  id           String   @id @default(cuid())
  customerName String
  rating       Int
  comment      String
  imageUrl     String?
  approved     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model GalleryImage {
  id        String   @id @default(cuid())
  url       String
  caption   String?
  category  String   @default("General")
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Offer {
  id          String    @id @default(cuid())
  title       String
  description String
  imageUrl    String?
  active      Boolean   @default(true)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model SiteSettings {
  id              String   @id @default("main")
  heroHeadline    String
  heroSubtext     String
  aboutHeading    String
  aboutText       String
  address         String
  phone           String
  email           String
  hours           Json
  socialLinks     Json
  instagramHandle String
  updatedAt       DateTime @updatedAt
}
