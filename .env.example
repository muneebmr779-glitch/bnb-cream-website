# This project uses two separate env files — copy each and fill in real values:
#   backend/.env.example  -> backend/.env
#   frontend/.env.example -> frontend/.env
#
# This root file is just a quick-reference summary of what's required.

# --- Backend (backend/.env) ---
# NODE_ENV=development
# PORT=5000
# CLIENT_URL=http://localhost:5173
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/car-repair
# JWT_SECRET=replace_with_a_long_random_secret_string
# JWT_EXPIRES_IN=7d
# ADMIN_NAME=Workshop Admin
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=ChangeMe123!
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM="AutoCare Pro <no-reply@autocarepro.com>"

# --- Frontend (frontend/.env) ---
# VITE_API_URL=http://localhost:5000/api
