# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/cakoo?schema=public"

# Secret used to sign admin session JWTs — generate a long random string in production
JWT_SECRET="replace-with-a-long-random-secret"

# Used only by `npm run seed` to create the first admin account
ADMIN_SEED_EMAIL="admin@cakoo.com"
ADMIN_SEED_PASSWORD="change-me"

# Public site URL, used for metadata/sitemap generation
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional: configure a cloud storage provider for uploaded images.
# Leave unset to store uploads on local disk under /public/uploads (fine for dev/small deployments).
# STORAGE_PROVIDER="local" # or "s3"
# S3_BUCKET=""
# S3_REGION=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
